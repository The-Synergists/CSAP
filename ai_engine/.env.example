# BidSure verification engine — copy to .env (git-ignored)
AI_ENGINE_PORT=8000
ENVIRONMENT=development
# Only the backend gateway calls the engine.
ALLOWED_ORIGINS=http://localhost:5000

# NVIDIA model 1 — Nemotron Parse 2.0 (integrate.api.nvidia.com, OpenAI-compatible chat completions)
NVIDIA_OCR_API_KEY=nvapi-...
NEMOTRON_OCR_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_OCR_MODEL=nvidia/nemotron-parse-2.0

# NVIDIA model 2 — information extraction (OpenAI-compatible chat completions)
NVIDIA_EXTRACTION_API_KEY=nvapi-...
NVIDIA_EXTRACTION_BASE_URL=https://integrate.api.nvidia.com/v1
# In use since 2026-09-27 (replaced nvidia/nemotron-3-ultra-550b-a55b)
NVIDIA_EXTRACTION_MODEL=nvidia/nemotron-3-super-120b-a12b
