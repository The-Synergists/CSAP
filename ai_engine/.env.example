# CSAP AI Engine — Environment Configuration

# --- Server ---
AI_ENGINE_PORT=8000
ENVIRONMENT=development

# --- NVIDIA Nemotron OCR V2 (build.nvidia.com) ---
# Get your key at: https://build.nvidia.com → Get API Key
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides (defaults shown)
# NEMOTRON_OCR_ENDPOINT=https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-ocr-v2/infer
# NEMOTRON_OCR_MERGE_LEVEL=paragraph   # word | sentence | paragraph

# --- Registry Mocking ---
ENABLE_MOCK_REGISTRIES=true
