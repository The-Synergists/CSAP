# BidSure verification engine — copy to .env (git-ignored)
AI_ENGINE_PORT=8000
ENVIRONMENT=development
# Only the backend gateway calls the engine.
ALLOWED_ORIGINS=http://localhost:5000

# NVIDIA model 1 — Nemotron OCR V2 (build.nvidia.com)
NVIDIA_OCR_API_KEY=nvapi-...
NEMOTRON_OCR_ENDPOINT=https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-ocr-v2
NEMOTRON_OCR_MERGE_LEVEL=paragraph

# NVIDIA model 2 — information extraction (OpenAI-compatible chat completions)
NVIDIA_EXTRACTION_API_KEY=nvapi-...
NVIDIA_EXTRACTION_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EXTRACTION_MODEL=nvidia/nemotron-3-ultra-550b-a55b
