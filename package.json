{
  "name": "csap",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "database"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:engine": "node scripts/py.mjs -m uvicorn src.main:app --port 8000",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck && npm --prefix backend run typecheck",
    "seed": "npm --prefix database run seed",
    "test:engine": "node scripts/py.mjs -m pytest -q",
    "test:live": "npm --prefix backend run test:live",
    "dev:pan-api": "node scripts/py.mjs --cwd pan_api -m uvicorn app:app --port 8100",
    "test:pan-api": "node scripts/py.mjs --cwd pan_api -m pytest -q",
    "migrate": "npm --prefix database run migrate"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  },
  "type": "module"
}
