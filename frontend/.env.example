# Where the app gets its data:
#   api  — the BidSure backend (backend/, port 5000) backed by Supabase. Default for local dev.
#   demo — built-in demo dataset in the browser; no backend needed (e.g. static preview).
VITE_DATA_SOURCE=api

# Backend base URL. Leave empty in development: Vite proxies /api to http://localhost:5000.
VITE_API_URL=

# Supabase Realtime (live updates). Public anon key only — never the service-role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
