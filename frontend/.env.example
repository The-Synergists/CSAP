# CSAP Frontend Environment Configuration

# Supabase API (Required for authentication and live data)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: CSAP Backend API Gateway URL (defaults to proxy or localhost:5000)
VITE_BACKEND_URL=http://localhost:5000

# Optional: CSAP AI Engine URL (defaults to localhost:8000)
VITE_AI_ENGINE_URL=http://localhost:8000
