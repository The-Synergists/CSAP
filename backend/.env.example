# BidSure backend gateway — copy to .env (never commit .env)

PORT=5000
NODE_ENV=development

# Supabase project (Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-side only. Used for login lookups and seeding; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Python verification engine (ai_engine)
AI_ENGINE_URL=http://localhost:8000

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Government Gateway (gov_gateway/): simulated registries
GOV_GATEWAY_URL=http://localhost:8100
GOV_GATEWAY_KEY=csap-demo-pan-key

# Live GSTIN provider (gstinapi.in). Leave the key empty to keep GSTN simulated only.
# Each found or not-found lookup costs a credit; answers are cached for GSTIN_CACHE_DAYS.
GSTIN_PROVIDER_URL=https://www.gstinapi.in
GSTIN_PROVIDER_KEY=
GSTIN_CACHE_DAYS=30

# Backup GSTIN provider (gstinapi.com), used only when the primary cannot answer.
GSTIN_FALLBACK_URL=https://gstinapi.com/api
GSTIN_FALLBACK_KEY=

# Simulated GeM portal -> CSAP intake webhook (HMAC-SHA256 shared secret). Set a random value.
GEM_WEBHOOK_SECRET=
# Public base URL of this deployment (defaults to the Vercel production URL, or localhost)
CSAP_PUBLIC_URL=
